  <remove-project name="android_external_wpa_supplicant_8" />
  <project path="external/wpa_supplicant_8" name="external/wpa_supplicant_8" remote="fox" revision="45bbb7c0537b1a9c6138ac1ac0d01b482379b1c5" />

  <!-- ============================================================
       Additions: OrangeFox vendor tree, recovery build dependencies,
       and qcom commons. Not present in the twrp-16 minimal manifest.
       ============================================================ -->

  <project path="vendor/recovery" name="vendor/recovery" remote="fox" revision="cea00cabf2e8ce50fc9f0b5cda99b5801855847a" />

  <project path="external/foxcli" name="external/foxcli" remote="fox" revision="ce8125d5dba50b3c03e8c674221206bb7ce5c705" />
  <project path="external/libvterm" name="external/libvterm" remote="fox" revision="19d04214c6f276f5eae6f7bcdc1794b7dccf84bd" />
  <project path="external/libuv" name="external/libuv" remote="fox" revision="7c3aedb62ef4b369d41b91d8a6712ebb8fe427a2" />
  <project path="external/json-c" name="external/json-c" remote="fox" revision="79a8ff67c9ec24770b0aacf22ed779a94b1937c9" />
  <project path="external/libwebsockets" name="external/libwebsockets" remote="fox" revision="54fcad4800229f4d75cc74a3254fdb62e2a4b4c8" />
  <project path="external/ttyd" name="external/ttyd" remote="fox" revision="30aa1f9fc7d8500244d125ae0b3338aeb63eb498" />
  <project path="external/rclone" name="external/rclone" remote="fox" revision="de5ab07087a9132f3f027bedcf698856a1d37d29" />
  <project path="external/dnsmasq" name="external/dnsmasq" remote="fox" revision="b7268972ef9153562001b7be986c756d0f5490d7" />

  <!-- crates-io must be a swap at the canonical path, never an addition at a new
       one. The base manifest already carries AOSP's copy; OrangeFox ships a
       pre-patched snapshot of the same upstream commit (c991cad1), and Soong
       resolves rustlibs by module name over the whole filesystem, so keeping both
       redefines every crate and aborts the bootstrap.

       OrangeFox's copy wins: external/foxcli is a "recovery: true" rust_binary
       that links libclap / liblibc / libserde_json, and those modules only carry
       recovery_available: true in the patched tree (see
       external/foxcli/patches/README.md). The two trees are otherwise identical
       apart from that flag on 10 crates, so nothing is lost by dropping AOSP's.

       It has to land on external/rust/android-crates-io specifically: Soong
       resolves visibility by directory path, and the snapshot hardcodes that path
       in its own grants (crates/fragile/Android.bp:46 ->
       //external/rust/android-crates-io/crates/mockall, likewise
       crates/vsprintf/Android.bp:33, plus grants made to it from
       external/boringssl). Checked out anywhere else, every one of those grants
       dangles and soong_build fails. -->
  <remove-project name="platform/external/rust/android-crates-io" />
  <project path="external/rust/android-crates-io" name="external/android-crates-io" remote="fox" revision="46022a5c0eb60cbfc7421040ae66c679a63c49dc" />

  <project path="device/qcom/twrp-common" name="device/qcom-twrp-common" remote="fox" revision="98506f7919102378c8d52ee7d6a94a867f1b4c55" />
  <project path="device/qcom/common" name="android_device_qcom_common" remote="teamwin" revision="2cf934339972feb6f711e5ad182b82157269c7f3" />

  <!-- Reference device tree shipped by the official fox_16.0 manifest
       (Xiaomi device on the same OrangeFox release). Kept for comparison. -->
  <project path="device/xiaomi/mondrian" name="device/mondrian" remote="fox" revision="c09654508af5839c78e97e309dcffc65a735454a" />

  <!-- ============================================================
       Pins: freeze the projects the base manifest still tracks by
       branch or tag. Pinning the base manifest to a SHA fixes which
       projects exist; it does not fix which commit each one sits on,
       because the branch names live in the base manifest's own text.

       These all come from the base manifest, so their remote names
       (twrp-16.0, LineageOS, github, aosp) are the base manifest's,
       not the fox/teamwin pair declared above. Every SHA is the tip
       of its branch as of 2026-09-27 and equals what a sync of this
       manifest resolved to; this changes nothing today, it only stops
       the drift from starting.

       external/scrypt, system/keymaster, external/magisk-prebuilt and
       system/libziparchive all land in the recovery image, so for
       those four a moved branch is a different binary, not just a
       newer one.
       ============================================================ -->

  <remove-project name="android_cts" />
  <project path="cts" name="android_cts" remote="twrp-16.0" revision="e70f92f52c9830ee8f93d89d032e2b14765c5941" />

  <remove-project name="android_external_bash" />
