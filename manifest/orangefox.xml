  <remove-project name="android_external_sqlite" />
  <project path="external/sqlite" name="external/sqlite" remote="fox" revision="28e3f5878182658a5c34d3ce0859e950f2885aba" />

  <remove-project name="android_external_libxml2" />
  <project path="external/libxml2" name="external/libxml2" remote="fox" revision="4d33dd4f7f03568c09c7886a6a6d07512daa8374" />

  <remove-project name="android_external_icu" />
