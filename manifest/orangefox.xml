  <remove-project name="android_build_soong" />
  <project path="build/soong" name="build/soong" remote="fox" revision="6dc77879464584ef3f178cae622134ed0bf19e1e">
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <remove-project name="android_bionic" />
  <project path="bionic" name="bionic" remote="fox" revision="33fcbd9974be3b3b2899a484f8c0cb8dfa2d5e82" />

  <remove-project name="android_hardware_interfaces" />
  <project path="hardware/interfaces" name="hardware/interfaces" remote="fox" revision="bdefb2a8bce20dc15882d4ab668fb628c427e26b" />

  <remove-project name="android_frameworks_hardware_interfaces" />
  <project path="frameworks/hardware/interfaces" name="frameworks/hardware/interfaces" remote="fox" revision="51d97a046f77b7dc3531cc6bb99407539d4e29b6" />

