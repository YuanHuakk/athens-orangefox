+static ::ndk::SpAIBinder waitForKeystoreService(const char* name) {
+    if (!android::base::GetBoolProperty("ro.orangefox.boot", false)) {
+        return ::ndk::SpAIBinder(AServiceManager_waitForService(name));
+    }
+
+    // Recovery must still reach its UI when a crypto service cannot start.
+    // Poll without lazy-start requests and retain the acquired binder so there
+    // is no second, unbounded service lookup after the readiness check.
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+    do {
+        ::ndk::SpAIBinder binder(AServiceManager_checkService(name));
+        if (binder.get()) return binder;
+        std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    } while (std::chrono::steady_clock::now() < deadline);
+
+    LOG(ERROR) << "Timed out waiting for " << name << "; leaving storage encrypted";
+    return ::ndk::SpAIBinder();
+}
