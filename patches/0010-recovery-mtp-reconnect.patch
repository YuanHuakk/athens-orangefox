 	}
@@ -3150,6 +3150,13 @@ bool TWPartitionManager::Enable_MTP(void) {
 		char vendor[PROPERTY_VALUE_MAX];
 		char product[PROPERTY_VALUE_MAX];
 		property_set("sys.usb.config", "none");
+		if (!android::base::WaitForProperty("sys.usb.state", "none", std::chrono::seconds(5))) {
+			LOGERR("Timed out disabling USB before MTP startup\n");
+			close(mtppipe[0]);
+			close(mtppipe[1]);
+			property_set("sys.usb.config", "adb");
+			return false;
+		}
 		property_get("usb.vendor", vendor, "18D1");
 		property_get("usb.product.mtpadb", product, "4EE2");
 		string vendorstr = vendor;
@@ -3163,6 +3170,7 @@ bool TWPartitionManager::Enable_MTP(void) {
 	 */
 	twrpMtp *mtp = new twrpMtp(DataManager::GetIntValue("tw_mtp_debug"));
 	mtppid = mtp->forkserver(mtppipe);
+	delete mtp;
 	if (mtppid) {
 		close(mtppipe[0]); // Host closes read side
 		mtp_write_fd = mtppipe[1];
@@ -3173,6 +3181,7 @@ bool TWPartitionManager::Enable_MTP(void) {
 		close(mtppipe[0]);
 		close(mtppipe[1]);
 		gui_err("mtp_fail=Failed to enable MTP");
+		property_set("sys.usb.config", "adb");
 		return false;
 	}
 #else
@@ -3212,16 +3221,16 @@ bool TWPartitionManager::Disable_MTP(void) {
 		string productstr = product;
 		TWFunc::write_to_file("/sys/class/android_usb/android0/idVendor", vendorstr);
 		TWFunc::write_to_file("/sys/class/android_usb/android0/idProduct", productstr);
-		usleep(2000);
+		if (!android::base::WaitForProperty("sys.usb.state", "none", std::chrono::seconds(5)))
+			LOGERR("Timed out disabling USB while stopping MTP\n");
 	}
 #ifdef TW_HAS_MTP
 	if (mtppid) {
 		LOGINFO("Disabling MTP\n");
 		int status;
 		kill(mtppid, SIGKILL);
+		TEMP_FAILURE_RETRY(waitpid(mtppid, &status, 0));
 		mtppid = 0;
-		// We don't care about the exit value, but this prevents a zombie process
-		waitpid(mtppid, &status, 0);
 		close(mtp_write_fd);
 		mtp_write_fd = -1;
 	}
@@ -4657,10 +4666,23 @@ bool TWPartitionManager::Prepare_Empty_Folder(const std::string& Folder) {
 
 #ifdef TW_HAS_MTP
 bool TWPartitionManager::is_MTP_Enabled(void) {
-  if (mtppid)
-     return true;
-  else
-     return false;
+	if (!mtppid)
+		return false;
+	int status;
+	pid_t result = TEMP_FAILURE_RETRY(waitpid(mtppid, &status, WNOHANG));
+	if (result == 0)
+		return true;
+	if (result < 0 && errno != ECHILD) {
+		LOGERR("Unable to check MTP process: %s\n", strerror(errno));
+		return true;
+	}
+	mtppid = 0;
+	if (mtp_write_fd >= 0)
+		close(mtp_write_fd);
+	mtp_write_fd = -1;
+	property_set("sys.usb.ffs.mtp.ready", "0");
+	DataManager::SetValue("tw_mtp_enabled", 0);
+	return false;
 }
 #endif
 

diff --git a/mtp/ffs/MtpFfsHandle.cpp b/mtp/ffs/MtpFfsHandle.cpp
