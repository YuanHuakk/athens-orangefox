+	}
 	if (mBulkIn < 0) {
 		mBulkIn.reset(TEMP_FAILURE_RETRY(open(ptp ? FFS_PTP_EP_IN : FFS_MTP_EP_IN, O_RDWR)));
 		if (mBulkIn < 0) {
@@ -127,6 +135,7 @@ bool MtpFfsHandle::writeDescriptors(bool ptp) {
 }
 
 void MtpFfsHandle::closeConfig() {
+	android::base::SetProperty("sys.usb.ffs.mtp.ready", "0");
 	mControl.reset();
 }
 
@@ -297,7 +306,11 @@ int MtpFfsHandle::start(bool ptp) {
 }
 
 void MtpFfsHandle::close() {
-	io_destroy(mCtx);
+	if (mCtx) {
+		io_destroy(mCtx);
+		mCtx = 0;
+	}
+	mEventFd.reset();
 	closeEndpoints();
 	closeConfig();
 }

