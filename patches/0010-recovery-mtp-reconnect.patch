@@ -3130,7 +3130,7 @@ TWPartition *TWPartitionManager::Get_Default_Storage_Partition()
 
 bool TWPartitionManager::Enable_MTP(void) {
 #ifdef TW_HAS_MTP
-	if (mtppid) {
+	if (is_MTP_Enabled()) {
 		LOGINFO("MTP already enabled\n");
