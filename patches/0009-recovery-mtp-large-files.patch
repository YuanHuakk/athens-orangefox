diff --git a/mtp/ffs/MtpFfsCompatHandle.cpp b/mtp/ffs/MtpFfsCompatHandle.cpp
--- a/mtp/ffs/MtpFfsCompatHandle.cpp
+++ b/mtp/ffs/MtpFfsCompatHandle.cpp
@@ -174,6 +174,7 @@
 	size_t length;
 	bool read = false;
 	bool write = false;
+	bool short_packet = false;
 
 	posix_fadvise(mfr.fd, 0, 0, POSIX_FADV_SEQUENTIAL | POSIX_FADV_NOREUSE);
 
@@ -218,12 +219,13 @@
 				// For larger files, receive until a short packet is received.
 				if (static_cast<size_t>(ret) < length) {
 					file_length = 0;
+					short_packet = true;
 				}
 			} else {
 				file_length -= ret;
 			}
 			// Enqueue a new write request
-			aio_prepare(&aio, data, length, offset);
+			aio_prepare(&aio, data, ret, offset);
 			aio_write(&aio);
 
 			offset += ret;
@@ -233,8 +235,8 @@
 			read = false;
 		}
 	}
-	// Receive an empty packet if size is a multiple of the endpoint size.
-	if (ret % packet_size == 0 || zero_packet) {
+	// A short read already consumed the end of an unknown-length transfer.
+	if ((ret % packet_size == 0 && !short_packet) || zero_packet) {
 		if (TEMP_FAILURE_RETRY(::read(mBulkOut, data, packet_size)) != 0) {
 			return -1;
 		}

