+#if !defined(USE_QTI_HAPTICS) && !defined(USE_QTI_AIDL_HAPTICS) && !defined(USE_SAMSUNG_HAPTICS)
+// Newer Qualcomm drivers expose force feedback through evdev instead of the
+// timed_output or LED sysfs interfaces. Keep the fd open while an effect plays.
+static int vibrate_evdev(int timeout_ms)
+{
+    static std::mutex lock;
+    std::lock_guard<std::mutex> guard(lock);
+    static int fd = -1;
+    static int effect_id = -1;
+    if (fd < 0) {
+        DIR* dir = opendir("/dev/input");
+        if (!dir) return -1;
+        struct dirent* entry;
+        while ((entry = readdir(dir))) {
+            if (strncmp(entry->d_name, "event", 5) != 0) continue;
+            std::string path = std::string("/dev/input/") + entry->d_name;
+            int candidate = open(path.c_str(), O_RDWR | O_CLOEXEC);
+            if (candidate < 0) continue;
+            unsigned long caps[(FF_MAX + sizeof(unsigned long) * 8) / (sizeof(unsigned long) * 8)] = {};
+            const size_t bits = sizeof(unsigned long) * 8;
+            if (ioctl(candidate, EVIOCGBIT(EV_FF, sizeof(caps)), caps) >= 0 &&
+                (caps[FF_CONSTANT / bits] & (1UL << (FF_CONSTANT % bits)))) {
+                fd = candidate;
+                LOGI("Using evdev haptics: %s\n", path.c_str());
+                break;
+            }
+            close(candidate);
+        }
+        closedir(dir);
+        if (fd < 0) return -1;
+    }
+
+    if (timeout_ms <= 0 && effect_id < 0) return 0;
+    if (timeout_ms > 0) {
+        struct ff_effect effect = {};
+        effect.type = FF_CONSTANT;
+        effect.id = effect_id;
+        effect.u.constant.level = 0x4000;
+        effect.replay.length = timeout_ms;
+        // Re-upload on every click: the driver may stop its module at expiry.
+        if (ioctl(fd, EVIOCSFF, &effect) < 0) {
+            LOGI("Unable to upload haptic effect: %s\n", strerror(errno));
+            return -1;
+        }
+        effect_id = effect.id;
+    }
+    struct input_event event = {};
+    event.type = EV_FF;
+    event.code = effect_id;
+    event.value = timeout_ms > 0 ? 1 : 0;
+    return write(fd, &event, sizeof(event)) == sizeof(event) ? 0 : -1;
+}
+#endif
