+// Handle power+volume shortcuts on key-down, before the hold timer.
+// Accept either key order; return true when the shortcut consumes the press.
+static bool handlePowerVolumeShortcut(int code, HardwareKeyboard *kb)
+{
+	bool torch = false;
+
+	if (code == KEY_POWER) {
+		if (kb->IsKeyDown(KEY_VOLUMEUP))
+			torch = true;
+		else if (!kb->IsKeyDown(KEY_VOLUMEDOWN))
+			return false;
+	} else if (code == KEY_VOLUMEUP) {
+		if (!kb->IsKeyDown(KEY_POWER))
+			return false;
+		torch = true;
+	} else if (code == KEY_VOLUMEDOWN) {
+		if (!kb->IsKeyDown(KEY_POWER))
+			return false;
+	} else {
+		return false;
+	}
+
+	if (torch)
+		GUIAction::flashlightImpl("");
+	else
+		GUIAction::screenshotImpl("");
+	DataManager::Vibrate("tw_button_vibrate");
+
+	// Keep the power key's release path from toggling the screen for this press.
+	g_suppress_power_toggle_until_ms = nowMs() + 1000;
+	return true;
+}
+
 void InputHandler::process_EV_KEY(input_event& ev)
 {
 	HardwareKeyboard *kb = PageManager::GetHardwareKeyboard();
@@ -493,6 +526,14 @@ void InputHandler::process_EV_KEY(input_event& ev)
 			return;
 		}
 #endif
+		// Clear hold state before KeyDown, which remaps keys when mime > 500.
+		if (handlePowerVolumeShortcut(ev.code, kb)) {
+			mime = 0;
+			kb->KeyDown(ev.code);
+			key_status = KS_NONE;
+			touch_status = TS_NONE;
+			return;
+		}
 		if (kb->KeyDown(ev.code) >= 0) {
 			// Key repeat is enabled for this key
 			key_status = KS_KEY_PRESSED;
@@ -532,8 +573,8 @@ void InputHandler::process_EV_KEY(input_event& ev)
 				}
 			}
 		}
-		if (mime <= 500)
-			kb->KeyUp(ev.code);
+		// Release held keys as well, so later shortcuts cannot match stale state.
+		kb->KeyUp(ev.code);
 		key_status = KS_NONE;
 		touch_status = TS_NONE;
 #ifdef TW_USE_KEY_CODE_TOUCH_SYNC
@@ -722,11 +763,10 @@ static void loopTimer(int input_timeout_ms)
 
 		timespec diff = TWFunc::timespec_diff(lastCall, curTime);
 
-		// This is really 2 or TW_FRAMERATE times per second
-		// As long as we get events, increase the timeout so we can catch up with input
-		long timeout = got_event ? 500000000 : (1.0 / TW_FRAMERATE * 1000000000);
+		// Bound input draining to one frame, even under continuous touch events.
+		const long timeout = 1000000000L / TW_FRAMERATE;
 
-		if (diff.tv_sec || diff.tv_nsec > timeout)
+		if (diff.tv_sec || diff.tv_nsec >= timeout)
 		{
 			// int32_t input_time = TWFunc::timespec_diff_ms(lastCall, curTime);
 			// LOGINFO("loopTimer(): %u ms, count: %u\n", input_time, count);
@@ -736,10 +776,9 @@ static void loopTimer(int input_timeout_ms)
 			return;
 		}
 
-		// We need to sleep some period time microseconds
-		//unsigned int sleepTime = 33333 -(diff.tv_nsec / 1000);
-		//usleep(sleepTime); // removed so we can scan for input
-		input_timeout_ms = 0;
+		// Drain queued input without waiting, then let poll sleep until the next
+		// frame. New input wakes poll immediately; an empty queue must not spin.
+		input_timeout_ms = got_event ? 0 : (timeout - diff.tv_nsec + 999999) / 1000000;
 	} while (1);
 }
 
