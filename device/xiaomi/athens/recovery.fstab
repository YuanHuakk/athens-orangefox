# The crypto flag values below are copied verbatim from the stock first-stage
# fstab.qcom. TWRP reads fileencryption/metadata_encryption/keydirectory off this
# file to drive decryption; the HALs that unwrap the keys are staged under
# recovery/root/vendor and started from init.recovery.qcom.rc.
/system_root erofs /dev/block/mapper/system flags=logical;slotselect;backup=0;canbewiped=0;wipeingui=0;fsflags=ro
/system_ext erofs /dev/block/mapper/system_ext flags=logical;slotselect;backup=0;canbewiped=0;wipeingui=0;fsflags=ro
/product erofs /dev/block/mapper/product flags=logical;slotselect;backup=0;canbewiped=0;wipeingui=0;fsflags=ro
/vendor erofs /dev/block/mapper/vendor flags=logical;slotselect;backup=0;canbewiped=0;wipeingui=0;fsflags=ro
/odm erofs /dev/block/mapper/odm flags=logical;slotselect;backup=0;canbewiped=0;wipeingui=0;fsflags=ro
/vendor_dlkm erofs /dev/block/mapper/vendor_dlkm flags=logical;slotselect;backup=0;canbewiped=0;wipeingui=0;fsflags=ro
/system_dlkm erofs /dev/block/mapper/system_dlkm flags=logical;slotselect;backup=0;canbewiped=0;wipeingui=0;fsflags=ro
/mi_ext erofs /dev/block/mapper/mi_ext flags=logical;slotselect;backup=0;canbewiped=0;wipeingui=0;fsflags=ro

/boot emmc /dev/block/by-name/boot flags=slotselect;backup=1;flashimg=0
/init_boot emmc /dev/block/by-name/init_boot flags=slotselect;backup=1;flashimg=0
/vendor_boot emmc /dev/block/by-name/vendor_boot flags=slotselect;backup=1;flashimg=0
/recovery emmc /dev/block/by-name/recovery flags=slotselect;backup=1;flashimg=0
/dtbo emmc /dev/block/by-name/dtbo flags=slotselect;backup=1;flashimg=0
/misc emmc /dev/block/by-name/misc flags=backup=0;flashimg=0

/data f2fs /dev/block/by-name/userdata flags=fsflags=noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier,inlinecrypt;fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0;metadata_encryption=aes-256-xts:wrappedkey_v0;keydirectory=/metadata/vold/metadata_encryption;wrappedkey;quota;canbewiped;wipeingui

# Metadata holds the wrapped FBE key blobs (/metadata/vold/metadata_encryption).
# Deliberately not exposed to the Wipe menu: wiping it alone destroys the
# metadata key and makes /data permanently undecryptable.
/metadata f2fs /dev/block/by-name/metadata flags=fsflags=noatime,nosuid,nodev,discard;backup=0;wipeingui=0;canbewiped=0

/mnt/vendor/persist ext4 /dev/block/by-name/persist flags=fsflags=noatime,nosuid,nodev,barrier=1;backup=0;wipeingui=0;canbewiped=0

# Match only USB-host block uevents; sda through sdf belong to internal UFS.
/devices/platform/soc/a600000.ssusb/a600000.dwc3/* /usb_otg auto defaults removable,storage,display="USB OTG",wipeingui=0,canbewiped=0
